    "A chest with a riddle carved into its lid." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Truhe mit einem Rätsel im Deckel."
          }
        }
      }
    },
    "A fallen knight's pack lies by the road. Read the old inscription to claim it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bündel eines gefallenen Ritters liegt am Weg. Lies die alte Inschrift, um es zu nehmen."
          }
        }
      }
    },
    "A forgotten shrine hums with old knowledge." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein vergessener Schrein summt vor altem Wissen."
          }
        }
      }
    },
    "A glowing spring bubbles between the stones." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine leuchtende Quelle sprudelt zwischen den Steinen."
          }
        }
      }
    },
    "A hooded stranger blocks the path with a riddle." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein vermummter Fremder versperrt mit einem Rätsel den Weg."
